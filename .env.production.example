# Dokploy runtime identity and timezone.
PUID=1000
PGID=1000
TZ=America/Sao_Paulo

# Cloudflare Access is the primary GUI boundary. A non-empty Chromium password
# is still recommended as defense in depth.
CHROMIUM_USER=browser
CHROMIUM_PASSWORD=replace-with-a-long-random-password
# X11 is intentional: CDP Page.captureScreenshot timed out under the image's
# default Wayland compositor in validation.
PIXELFLUX_WAYLAND=false

# Auth0 issuer must match the iss claim exactly, including its trailing slash.
MCP_OAUTH_ISSUER=https://your-tenant.us.auth0.com/

# Copy the owner's exact Auth0 user_id/sub. Multiple values are comma-separated.
MCP_OAUTH_ALLOWED_SUBJECTS=auth0|replace-with-owner-subject

# Optional operational tuning.
MCP_OAUTH_DISCOVERY_TIMEOUT_MS=10000
MCP_ACTION_TIMEOUT_MS=10000
MCP_NAVIGATION_TIMEOUT_MS=60000
MCP_SESSION_IDLE_TIMEOUT_MS=1800000
MCP_SNAPSHOT_MAX_CHARS=12000
MCP_SNAPSHOT_MAX_ELEMENTS=150

# Optional saved-login broker. The referenced files must be mounted as Docker
# secrets in the gateway container; never store credential values in Dokploy
# environment variables or in this repository.
MCP_SAVED_LOGINS_FILE=
MCP_SAVED_LOGIN_SECRETS_DIR=/run/secrets
