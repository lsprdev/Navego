TZ=America/Sao_Paulo
PUID=1000
PGID=1000
NAVEGO_AGENT_ID=primary

# Gere valores independentes e longos. Não reutilize credenciais de usuário.
NAVEGO_AGENT_TOKEN=replace-with-at-least-32-random-bytes
NAVEGO_WORKER_API_KEY=replace-with-another-32-random-bytes
# Gere com `openssl rand -base64 32` e mantenha em backup seguro. Sem esta
# chave, as credenciais cifradas não podem ser recuperadas.
NAVEGO_VAULT_KEY=replace-with-a-base64-encoded-32-byte-key

# As URLs públicas são fixadas no compose.dokploy.yaml:
# dashboard/viewer: https://browser.lspr.dev
# MCP: https://mcp.browser.lspr.dev/mcp

# OAuth do MCP será adicionado no milestone M6. Cloudflare Access deve proteger
# o dashboard, mas as rotas /viewer continuam exigindo ticket curto do Navego.
