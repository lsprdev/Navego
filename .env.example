# LinuxServer.io container user. On macOS/Docker Desktop the defaults are fine.
PUID=1000
PGID=1000
TZ=America/Sao_Paulo

# Optional Basic Auth for the Chromium GUI only. The GUI stays on localhost.
CHROMIUM_USER=abc
CHROMIUM_PASSWORD=
# Keep false: the tested Chromium image can hang Page.captureScreenshot under
# its default Wayland compositor. Enable only after a CDP screenshot smoke.
PIXELFLUX_WAYLAND=false

# Address shown by the MCP when a human must enter credentials, 2FA or CAPTCHA.
# Keep the GUI private; on a remote host, use this URL through SSH or a VPN.
HUMAN_TAKEOVER_URL=https://127.0.0.1:3001

# Optional static Bearer token for local clients that support custom headers.
# Keep empty for Codex project config and the first temporary ChatGPT test.
NAVEGO_API_KEY=

# OAuth resource-server mode. Keep disabled for the normal local Codex flow.
# For an Auth0 + fixed ngrok domain test, enable it and use the exact public
# /mcp URL as both MCP_PUBLIC_URL and MCP_OAUTH_AUDIENCE.
MCP_OAUTH_ENABLED=false
MCP_PUBLIC_URL=
MCP_OAUTH_ISSUER=
MCP_OAUTH_AUDIENCE=
MCP_OAUTH_ALLOWED_SUBJECTS=
MCP_OAUTH_DISCOVERY_TIMEOUT_MS=10000

# Go MCP gateway configuration.
MCP_ACTION_TIMEOUT_MS=10000
MCP_NAVIGATION_TIMEOUT_MS=60000
MCP_SESSION_IDLE_TIMEOUT_MS=1800000
MCP_SNAPSHOT_MAX_CHARS=12000
MCP_SNAPSHOT_MAX_ELEMENTS=150

# Optional server-side saved-login broker. Leave empty to keep it disabled.
# When enabled, mount the manifest and credential files read-only under the
# secrets directory; never put usernames or passwords in this env file.
MCP_SAVED_LOGINS_FILE=
MCP_SAVED_LOGIN_SECRETS_DIR=/run/secrets

# Required only by compose.ngrok.yaml.
NGROK_AUTHTOKEN=
