# Runtime local do Navego. Troque os tokens antes de expor qualquer serviço.
TZ=America/Sao_Paulo
PUID=1000
PGID=1000
NAVEGO_AGENT_ID=primary
NAVEGO_AGENT_TOKEN=local-agent-token-change-me
NAVEGO_WORKER_API_KEY=local-worker-token-change-me
# Chave local conhecida apenas para desenvolvimento. Gere outra antes do deploy:
# openssl rand -base64 32
NAVEGO_VAULT_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# URLs mostradas/abertas pelo dashboard.
NAVEGO_PUBLIC_VIEWER_URL=http://127.0.0.1:8090
NAVEGO_PUBLIC_DASHBOARD_URL=http://127.0.0.1:3000
NAVEGO_PUBLIC_DASHBOARD_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
NAVEGO_PUBLIC_MCP_URL=http://127.0.0.1:8090/mcp

# Necessário somente para compose.ngrok.yaml.
NGROK_AUTHTOKEN=
# Domínio HTTPS fixo atribuído no painel do ngrok, sem barra final.
# Exemplo: https://your-name.ngrok.app
NGROK_URL=
